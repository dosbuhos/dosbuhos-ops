{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Custom domain once dosbuhos.com's DNS is on Cloudflare (uncomment, push):
  // "routes": [{ "pattern": "apps.dosbuhos.com", "custom_domain": true }],
  // Every request goes through the Worker first: pages and the kit sit behind Google sign-in.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hub", "database_id": "1a971736-3a72-4e2c-9db8-2e6d746444cc", "migrations_dir": "migrations" }
  ],
  // The apps the Hub can proxy to (/<slug>/… → that Worker, with a signed X-DB-User header). An app's row in the
  // registry says which binding it uses (apps.binding) and whether it is proxied yet (apps.mode = 'proxy').
  "services": [
    { "binding": "CELLAR", "service": "cellar" },
    { "binding": "HUERTO", "service": "huerto-dos-buhos" },
    { "binding": "MANTENIMIENTO", "service": "dosbuhos-mantenimiento" },
    { "binding": "SPARK", "service": "spark" },
    { "binding": "WINECLUB", "service": "wineclub" },
    { "binding": "OPS", "service": "dosbuhos-ops" }
  ],
  "vars": {
    // Same OAuth client as the cellar app ("Cellar calendar", Google Cloud project dos-buhos).
    "GOOGLE_CLIENT_ID": "700169529332-m23018v6lhm16cvll8gi9e7hj4ak4l73.apps.googleusercontent.com"
  }
  // Secrets (Cloudflare dashboard → hub → Settings → Variables and Secrets, or `npx wrangler secret put NAME`):
  // GOOGLE_CLIENT_SECRET  the same value the cellar Worker has
  // SESSION_SECRET        any long random string; also signs the X-DB-User header the apps receive
  // HUB_ADMIN_EMAILS      comma-separated Google accounts that are Hub admins from their first sign-in (e.g. Eric's)
}
