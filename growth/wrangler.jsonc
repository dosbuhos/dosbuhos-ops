{
  // Dos Búhos Growth Terminal. Deployed by Workers Builds from main (root directory /growth). The top-level config is
  // the real app; `env.dev` is the local demo on synthetic data (`npm run dev`), which never deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth",
  "main": "src/index.ts",
  // nodejs_compat: the Anthropic SDK needs it.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Dashboard built into ./public (committed). run_worker_first for every path: pages are private too; the Worker
  // checks the Hub's signed identity before serving anything.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "DATA_KIND": "real",                 // must match business_settings.data_kind in DB, or the Worker refuses to run
    "ADS_PROVIDER": "google_ads_api",    // the API adapter refuses every write until Google Ads API access exists
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "WINERY_TZ": "America/Mexico_City"
  },
  "d1_databases": [
    // Growth's own facts, configuration, reports and the coordinator ledger projection.
    { "binding": "DB", "database_name": "growth", "database_id": "a55e5d23-3d7b-498c-aa66-e1145ae12bba", "migrations_dir": "migrations" },
    // The Hub's database, READ-ONLY use (src/connectors/hub-mirror.ts only SELECTs ads_perf / ads_campaigns / ads_config):
    // the Hub's hourly Google Ads Script already writes the Dos Búhos account there.
    { "binding": "HUB_DB", "database_name": "hub", "database_id": "1a971736-3a72-4e2c-9db8-2e6d746444cc" }
  ],
  // Raw feed payloads, import files and coordinator backups.
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "growth-archive" }],
  // One coordinator per ad account: the only code that may change the ad account.
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "AccountCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountCoordinator"] }],
  // Daily (08:00) and weekly (Monday 08:30) reviews, San Miguel time; started by the cron below.
  "workflows": [
    { "name": "growth-daily-review", "binding": "DAILY_REVIEW", "class_name": "DailyReviewWorkflow" },
    { "name": "growth-weekly-review", "binding": "WEEKLY_REVIEW", "class_name": "WeeklyReviewWorkflow" }
  ],
  // Every 15 minutes (UTC): watchdog, hourly Google Ads mirror, and the daily/weekly reviews by logical run key.
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": {
    // Local demo only: synthetic data in a local database, simulated ad account, no sign-in.
    "dev": {
      "name": "growth-dev",
      "vars": { "ENVIRONMENT": "dev", "DATA_KIND": "demo", "ADS_PROVIDER": "mock", "ANTHROPIC_MODEL": "claude-opus-5-5", "WINERY_TZ": "America/Mexico_City" },
      "d1_databases": [{ "binding": "DB", "database_name": "growth-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "growth-dev-archive" }],
      "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "AccountCoordinator" }] },
      "workflows": [
        { "name": "growth-dev-daily-review", "binding": "DAILY_REVIEW", "class_name": "DailyReviewWorkflow" },
        { "name": "growth-dev-weekly-review", "binding": "WEEKLY_REVIEW", "class_name": "WeeklyReviewWorkflow" }
      ],
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
  // Secrets (Worker growth → Settings → Variables and Secrets; Eric pastes the values):
  //   HUB_SECRET          required: the same value as the Hub's SESSION_SECRET. Without it every private route is refused.
  //   ANTHROPIC_API_KEY   optional: AI review and report narrative (or bind it from the account Secrets Store).
  //   GA4_SA_KEY          GA4 service account JSON key (Viewer on the GA4 property): OpenTable online reservations.
  //   FEED_TOKEN_PEPPER   optional: only for Growth's own richer Google Ads Script feed (scripts/google-ads-feed.js).
}
