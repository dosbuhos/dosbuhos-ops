{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ulula",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ulula",
      "database_id": "afcc8edc-e95c-4059-9db2-b376b698c841",
      "migrations_dir": "migrations"
    }
  ]
}
