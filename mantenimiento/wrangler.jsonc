{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dosbuhos-mantenimiento",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mantenimiento",
      "database_id": "56b0a16d-2344-4cf9-970a-db3e7c9d9558",
      "migrations_dir": "migrations"
    }
  ]
  ,"vars": { "MAIL_FROM": "mantenimiento@dosbuhos.com" }
  // Daily at 06:00 San Miguel (12:00 UTC): creates the work orders due from the preventive plans.
  // (They are also created whenever someone opens the app, so the cron is a safety net.)
  ,"triggers": { "crons": ["0 12 * * *"] }
  // Email login: after onboarding dosbuhos.com in Cloudflare Email Service (Workers Paid), uncomment:
  // ,"send_email": [{ "name": "EMAIL" }]
  // Optional, once R2 is enabled in the Cloudflare dashboard (photos move there automatically):
  // ,"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "mantenimiento-fotos" }]
}
