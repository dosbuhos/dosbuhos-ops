{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizonte",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horizonte",
      "database_id": "846a8b97-1a40-4964-a45f-7ec5911d7747",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Only this Google account can sign in. Eric's personal planner, not part of the Hub.
    "OWNER_EMAIL": "emaycotte@gmail.com",
    // Same OAuth client as the Hub; add https://horizonte.dos-buhos.workers.dev/auth/callback as a redirect URI.
    "GOOGLE_CLIENT_ID": "700169529332-m23018v6lhm16cvll8gi9e7hj4ak4l73.apps.googleusercontent.com"
  }
  // Secrets (Cloudflare dashboard → horizonte → Settings → Variables and secrets):
  // GOOGLE_CLIENT_SECRET  same value the Hub uses
  // SESSION_SECRET        optional; without it sessions are signed with GOOGLE_CLIENT_SECRET
}
