{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizonte",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Pulls Google Calendar changes every 5 minutes while the app is closed.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horizonte",
      "database_id": "846a8b97-1a40-4964-a45f-7ec5911d7747",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Only this Google account can sign in. Eric's personal planner, not part of the Hub.
    "OWNER_EMAIL": "emaycotte@gmail.com",
    // Horizonte's own OAuth client ("Horizonte" in Google Cloud project dos-buhos), separate from the Hub's.
    "GOOGLE_CLIENT_ID": "700169529332-h8g8o6bgvmu96jq77e70da5v51r2oojn.apps.googleusercontent.com"
  }
  // Sign-in needs no secret (Google button; ID token checked against Google's public keys).
  // Google Calendar sync needs the secret GOOGLE_CLIENT_SECRET (added by Eric in the dashboard) to keep a refresh token.
  // Google Cloud client "Cellar calendar" must list https://horizonte.dos-buhos.workers.dev as an Authorized JavaScript origin.
}
