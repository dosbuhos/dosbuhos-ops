{
  "name": "spark-equipo",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Phone app (static). The Worker answers /api/* only.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*", "/e/*"] },
  // Copies of the CRM sheet and of Zoho orders and invoices, the Zoho ↔ CRM name table and who is who.
  "d1_databases": [{ "binding": "DB", "database_name": "spark-equipo", "database_id": "4b2b0c5a-265d-4971-afdf-6470dadd7bc7", "migrations_dir": "migrations" }],
  // The Hub's session secret from the account Secrets Store: checks that requests really come from the Hub (src/hub-secret.js).
  "secrets_store_secrets": [
    // Claude writes the suggested next step for each account from the reps' notes (src/ai.js). Model: var AI_MODEL, default claude-sonnet-5-5.
    { "binding": "ANTHROPIC_API_KEY", "store_id": "1109ee14b3d349b3815f622f59dc3168", "secret_name": "ANTHROPIC_API_KEY" },
    { "binding": "HUB_SESSION_SECRET", "store_id": "1109ee14b3d349b3815f622f59dc3168", "secret_name": "HUB_SESSION_SECRET" }
  ],
  // Zoho through the Muestras Worker (zoho-inventory/, Worker dosbuhos-ops): it holds the Zoho secrets and exposes read-only lists.
  "services": [
    { "binding": "ZOHO", "service": "dosbuhos-ops", "entrypoint": "ZohoRead" },
    // Google Sheets through the cellar Worker: it holds the service-account key and reads the CRM sheet for us (read-only).
    { "binding": "SHEETS", "service": "cellar", "entrypoint": "SheetsRead" },
    // Gmail (read-only) through the cellar Worker: sales mailboxes on dosbuhos.com, for the owner's review and the Buzón.
    { "binding": "GMAIL", "service": "cellar", "entrypoint": "GmailRead" }
  ],
  // UTC. 12:00 = 6:00 in San Miguel (sheet + Zoho); 18:00 and 00:00 = noon and 6 pm (Zoho only).
  // The id of the deployed version, so an open tab can tell that a newer one is live and offer to reload.
  "version_metadata": { "binding": "VERSION" },
  // UTC. San Miguel is UTC-6: 6:00, noon and 18:00 run everything; the hours between, up to 21:00, read the CRM sheet only.
  "triggers": { "crons": ["0 12 * * *", "0 18 * * *", "0 0 * * *", "0 13-17,19-23,1-3 * * *"] },
  "vars": {
    // San Miguel de Allende, UTC-6 all year: "today" and week boundaries.
    "TZ": "America/Mexico_City",
    // Google Sheet "CRM Ventas Dos Búhos" (the reps' activity tabs).
    "CRM_SHEET_ID": "1dDoE0tRzGAEjnFv4ng2E4oLOk6a2h_ySepwUNrb7yd8",
    // Always admins here, besides Hub admins (comma separated).
    "ADMIN_EMAILS": "cabosari@dosbuhos.com",
    // Pesos per US dollar for export orders (La Competencia Imports), which Zoho holds in dollars. Update when it moves.
    "USD_MXN": "17.5"
  }
  // Secrets (Worker → Settings → Variables and Secrets):
  //   (HUB_SECRET is not pasted here: it comes from HUB_SESSION_SECRET in the Secrets Store.)
  //   None. The CRM sheet is read through the SHEETS binding; share the sheet (viewer) with the email shown in Ajustes.
  // Zoho needs no secrets here: it goes through the ZOHO binding. The token on dosbuhos-ops must be able to read invoices.
}
